# Test VMs for cockpit-samba-dc (see .claude/skills/vm-lab).
# Copy to .env, which is not tracked, and fill in the passwords.
# One KEY=value per line, no quotes: the value is everything after "=".

# Domain controller (Debian 13)
DC_VM=deb13-cockpit-samba-dc
DC_HOST=192.168.122.20
# Gateway and DNS forwarder of the libvirt network
GATEWAY=192.168.122.1
DC_MAC=52:54:00:5a:dc:20
DC_ADMIN_USER=maint
DC_ADMIN_PASSWORD=

# Domain provisioned on the DC
DOMAIN_REALM=samba.test
DOMAIN_NETBIOS=SAMBATEST
# Domain "Administrator"; must meet the default complexity rules
DOMAIN_ADMIN_PASSWORD=
# Password given to the test users the scripts create
DOMAIN_TEST_PASSWORD=

# Windows client (Windows 11), joined to the domain
WIN_VM=win11-cockpit-samba-pc
WIN_HOST=192.168.122.21
WIN_MAC=52:54:00:5a:dc:21
# NetBIOS computer name: at most 15 characters
WIN_COMPUTER_NAME=SAMBA-PC
# Local administrator, the one of the image the VM is cloned from
WIN_ADMIN_USER=maint
WIN_ADMIN_PASSWORD=
# Keyboard layout of the guest, for typing through virsh send-key
WIN_KEYMAP=it
