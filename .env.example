# Settings of the test VMs that belong to one workstation (test/vm/, skill
# vm-lab): the passwords and the Windows ISO. Copy to .env, which is not
# tracked, and fill it in. One KEY=value per line, no quotes: the value is
# everything after "=". Names, network, addresses and sizes are in
# test/vm/lab.conf; any of them may be overridden here, or in
# .env.<host name> for one workstation (also untracked).

# Admin account of the DC (DC_ADMIN_USER, "maint"): sudo with this password
DC_ADMIN_PASSWORD=
# Domain "Administrator"; must meet the default complexity rules
DOMAIN_ADMIN_PASSWORD=
# Password given to the test users (teacher1, student1, student2)
DOMAIN_TEST_PASSWORD=
# Local administrator of the Windows client (WIN_ADMIN_USER, "maint");
# Windows wants upper and lower case letters and digits
WIN_ADMIN_PASSWORD=

# Windows 11 Enterprise Evaluation ISO, downloaded from Microsoft's
# Evaluation Center (www.microsoft.com/evalcenter), readable by libvirt.
# Evaluation use only, for 90 days: rebuild the client when it expires.
# Its language must match WIN_LANG in lab.conf (it-IT), or override it here.
WIN_ISO=
# A local Debian 13 netinst image, instead of the installer of the mirror
#DEBIAN_ISO=
